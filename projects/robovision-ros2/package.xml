<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robovision_ros2</name>
  <version>1.0.0</version>
  <description>RoboVision: ROS2 &amp; ESP32 Autonomous Mobile Robot with 2D LiDAR SLAM, EKF Sensor Fusion, A* Navigation &amp; Real-Time Telemetry Bridge.</description>
  <maintainer email="seddikfeki15@gmail.com">Mohamed Seddik Feki</maintainer>
  <author email="seddikfeki15@gmail.com">Mohamed Seddik Feki</author>
  <license>Apache-2.0</license>

  <!-- Build Tool Dependencies -->
  <buildtool_depend>ament_python</buildtool_depend>

  <!-- ROS2 Core Message & Communication Dependencies -->
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Test Dependencies -->
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
